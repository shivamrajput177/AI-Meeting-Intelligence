# Go
/bin/

# Node / web
web/node_modules/
web/dist/
web/.vite/

# Local env overrides
.env
.env.local

# Real service configs — copied from
# deployments/configs/*.template.json and filled in with real values, so
# only the templates are checked in. (deployments/configs/docker/*.json
# is not covered by this and stays checked in — see its own README note.)
deployments/configs/*.json
!deployments/configs/*.template.json

# Downloaded whisper.cpp GGML model files — see
# deployments/whisper-models/README.md.
deployments/whisper-models/*.bin

# Editor/OS
.DS_Store
.idea/
.vscode/
