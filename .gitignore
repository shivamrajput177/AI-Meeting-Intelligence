# Go
/bin/

# Node / web
web/node_modules/
web/dist/
web/.vite/

# Local env overrides
.env
.env.local

# Phase 7 public-demo secrets (Cloudflare tunnel token, real demo hostname)
# — deployments/.env.demo.template is the checked-in, fillable-in-place
# version; see deployments/docker-compose.demo.yaml's header.
deployments/.env.demo

# Real service configs — copied from
# deployments/configs/*.template.json and filled in with real values, so
# only the templates are checked in. (deployments/configs/docker/*.json
# is not covered by this and stays checked in — see its own README note.)
deployments/configs/*.json
!deployments/configs/*.template.json

# Downloaded whisper.cpp GGML model files — see
# deployments/whisper-models/README.md.
deployments/whisper-models/*.bin

# Real demo sample recordings an operator drops in before running
# scripts/seed-demo-org.sh — see deployments/demo-seed/samples/README.md.
# Never this repo's to ship or commit.
deployments/demo-seed/samples/*
!deployments/demo-seed/samples/README.md

# Editor/OS
.DS_Store
.idea/
.vscode/

# Helm dependency build output — see deploy/helm/README.md. The 11
# service subcharts and meeting-intel-common stay committed as source;
# only the resolved/packaged .tgz + lock file are generated — including
# each service subchart's own nested charts/*.tgz from building its
# meeting-intel-common dependency, not just the umbrella's own.
deploy/helm/**/charts/*.tgz
deploy/helm/**/Chart.lock
