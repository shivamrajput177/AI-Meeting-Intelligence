{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Meetings processed / day",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(meetings_processed_total[1d])",
          "legendFormat": "meetings/day",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Avg time-to-summary (transcription + LLM)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(transcription_duration_seconds_sum[1h]) / rate(transcription_duration_seconds_count[1h])",
          "legendFormat": "avg transcription",
          "refId": "A"
        },
        {
          "expr": "rate(llm_call_duration_seconds_sum[1h]) / rate(llm_call_duration_seconds_count[1h])",
          "legendFormat": "avg LLM ({{model}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Action items extracted / day",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(action_items_extracted_total[1d])",
          "legendFormat": "items/day",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "RAG query latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_query_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Notification failures / hour, by channel",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(notification_failed_total[1h])) by (channel)",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
