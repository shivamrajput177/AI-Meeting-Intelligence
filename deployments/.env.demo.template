# Phase 7 public-demo environment file. Copy to deployments/.env.demo (which
# .gitignore already excludes — see its own entry) and fill in real values;
# never commit the filled-in copy. Used via:
#
#   docker compose -f deployments/docker-compose.yaml \
#                   -f deployments/docker-compose.demo.yaml \
#                   --env-file deployments/.env.demo up -d --build
#
# See deployments/docker-compose.demo.yaml's own header for what each
# variable does, and docs/runbooks/demo-vm-provisioning.md for how to
# actually obtain the Cloudflare tunnel token.

# Points the 5 demo-affected services (api-gateway, meeting-service,
# ai-summary-service, action-item-service, search-service) at
# deployments/configs/demo/*.json instead of configs/docker/*.json — see
# that directory's own README.md for exactly what differs and why.
API_GATEWAY_CONFIG=./configs/demo/api-gateway.json
MEETING_SERVICE_CONFIG=./configs/demo/meeting-service.json
AI_SUMMARY_SERVICE_CONFIG=./configs/demo/ai-summary-service.json
ACTION_ITEM_SERVICE_CONFIG=./configs/demo/action-item-service.json
SEARCH_SERVICE_CONFIG=./configs/demo/search-service.json

# From `cloudflared tunnel token <tunnel-name>` after the one-time tunnel
# setup in deployments/cloudflared/README.md. Required — docker-compose.demo.yaml
# refuses to start the cloudflared service without it.
CLOUDFLARE_TUNNEL_TOKEN=

# The public hostname the tunnel routes to this VM (e.g.
# https://demo.yourdomain.com/api/v1) — baked into the web frontend's static
# JS bundle at build time, so changing this after the fact means rebuilding
# the web image, not just restarting the container.
DEMO_API_BASE_URL=https://demo.yourdomain.com/api/v1
